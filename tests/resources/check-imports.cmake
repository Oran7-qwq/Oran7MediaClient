cmake_minimum_required(VERSION 3.21)

# 以 qrc 成员而非磁盘空目录判断导入是否存在，覆盖安装后资源树的真实边界。
file(STRINGS "${ORAN7_SOURCE_ROOT}/qml.qrc" entries REGEX "<file>[^<]+</file>")
set(resources)
foreach(entry IN LISTS entries)
    string(REGEX REPLACE ".*<file>([^<]+)</file>.*" "\\1" relative "${entry}")
    get_filename_component(path "${ORAN7_SOURCE_ROOT}/${relative}" ABSOLUTE)
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "qrc 引用缺失文件：${relative}")
    endif()
    list(APPEND resources "${path}")
endforeach()
foreach(path IN LISTS resources)
    if(NOT path MATCHES "\\.qml$")
        continue()
    endif()
    get_filename_component(directory "${path}" DIRECTORY)
    file(STRINGS "${path}" imports REGEX "^[ \t]*import[ \t]+\"")
    foreach(line IN LISTS imports)
        string(REGEX MATCH "^[ \t]*import[ \t]+\"([^\"]+)\"" unused "${line}")
        get_filename_component(target "${directory}/${CMAKE_MATCH_1}" ABSOLUTE)
        set(found FALSE)
        foreach(member IN LISTS resources)
            string(FIND "${member}" "${target}/" prefix)
            if(member STREQUAL target OR prefix EQUAL 0)
                set(found TRUE)
                break()
            endif()
        endforeach()
        if(NOT found)
            message(FATAL_ERROR "QML 导入在资源中不存在：${path} -> ${line}")
        endif()
    endforeach()
endforeach()
message(STATUS "QML 资源文件与相对目录导入检查通过")
