# ---- 本地工具 / 个人配置 ----------------------------------------------------
.claude/

# ---- IDE -------------------------------------------------------------------
.vscode/
.qtcreator/
*.code-workspace

# Qt Creator 生成的文件
CMakeLists.txt.user
CMakeLists.txt.user.*
*.autosave

# ---- 构建产物 --------------------------------------------------------------
build/
build-*/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
*.cmake.stamp

# 编译产物（注意：ffmpeg6.0/ 是随仓库分发的预编译依赖，下面已显式放行）
*.o
*.obj
*.so
*.so.*
*.dylib
*.a
*.lib
*.exp
*.pdb
*.ilk
*.dll
*.exe
*.app/

# 放行随仓库分发的 FFmpeg 预编译 SDK
!ffmpeg6.0/**
!ffmpeg6.0/bin/**
!ffmpeg6.0/lib/**

# ---- FFmpeg 随附文档裁剪（须放在上面的 ! 放行之后，后匹配者优先）------------
# 示例程序源码、roff man 页（GitHub 语言统计会把 .1/.3 识别成 Roff）、
# 以及遗留的 ffpreset / ffprobe.xsd，编译与运行均不需要
ffmpeg6.0/share/

# bin/ 下的可执行文件一律保留：ffmpeg.exe / ffprobe.exe 被 QProcess 调用，
# SDL2.dll 是音频输出依赖，其余 dll 供链接与运行

# Qt 生成
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.moc
.qmake.stash
Makefile
Makefile.*
*.pro.user
*.pro.user.*

